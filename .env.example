# =========================================================================
# DR. VAIDIK CHAUHAN - SUPABASE POSTGRESQL ENVIRONMENT VARIABLES
# Get these keys from your Supabase Dashboard: Project Settings -> API
# =========================================================================

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Public Key (public safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Supabase Service Role Key (optional, for privileged server actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
